{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}╭───────────╮{#}"
    },
    {
      "type": "title",
      "format": "{user-name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;230;80;80}{#} {#38;2;230;80;80}user    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "title",
      "format": "{host-name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;230;80;80}{#} {#38;2;230;80;80}hname   {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "host",
      "format": "{name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;190;110;230}{#} {#38;2;190;110;230}host    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "uptime",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}uptime  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "os",
      "format": "{name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}distro  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;100;210;120}{#} {#38;2;100;210;120}kernel  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "bootmgr",
      "format": "{name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;190;110;230}{#} {#38;2;190;110;230}bootmgr {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "initsystem",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}init    {#}{#38;2;110;200;190}│{#}",
      "format": "{name}"
    },
    {
      "type": "command",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}OS Age  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "packages",
      "format": "{all}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;230;80;80}{#} {#38;2;230;80;80}pkgs    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "wm",
      "format": "{pretty-name} ({protocol-name})",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}wm      {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "lm",
      "format": "{pretty-name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}lm      {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "terminal",
      "format": "{pretty-name} {version}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}term    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;100;210;120}{#} {#38;2;100;210;120}shell   {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}cpu     {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}gpu     {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "display",
      "format": "{width}x{height} @ {refresh-rate}Hz",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;190;110;230}󰍹{#} {#38;2;190;110;230}monitor {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;90;210;200}{#} {#38;2;90;210;200}memory  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{size-percentage} - {filesystem}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}󰨎{#} {#38;2;80;160;240}root    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "disk",
      "folders": "/home",
      "format": "{size-percentage} - {filesystem}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;100;210;120}{#} {#38;2;100;210;120}home    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}╰───────────╯{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}