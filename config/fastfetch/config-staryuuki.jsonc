{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/staryuuki-bn.png",
    "width": 22,
    "height": 11,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    },
    "color": {
      "separator": "38;2;98;121;116"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;98;121;116}╭─{#}{#1;38;2;150;227;210} juang{#}{#38;2;98;121;116}@{#}{#1;38;2;221;128;141}cachyos {#}{#38;2;98;121;116}────────────────────{#}"
    },
    {
      "type": "os",
      "key": "󰣇  os",
      "keyColor": "38;2;150;227;210",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "  kernel",
      "keyColor": "38;2;158;216;202",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  wm",
      "keyColor": "38;2;166;205;195",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "  shell",
      "keyColor": "38;2;174;194;187",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  term",
      "keyColor": "38;2;182;183;179"
    },
    {
      "type": "cpu",
      "key": "  cpu",
      "keyColor": "38;2;189;172;172",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu",
      "keyColor": "38;2;197;161;164",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "  mem",
      "keyColor": "38;2;205;150;156",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  disk",
      "keyColor": "38;2;213;139;149",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": "󰔟  up",
      "keyColor": "38;2;221;128;141"
    },
    {
      "type": "custom",
      "format": "{#38;2;98;121;116}╰─{#} {#38;2;221;128;141}♥ staryuuki{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}