{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/staryuuki-mundo.png",
    "width": 38,
    "height": 21,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 0
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}╭───────────╮{#}"
    },
    {
      "type": "title",
      "format": "{user-name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;230;80;80}{#} {#38;2;230;80;80}user    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "title",
      "format": "{host-name}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;230;80;80}{#} {#38;2;230;80;80}hname   {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "uptime",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}uptime  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "os",
      "format": "{name} {arch}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}distro  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "kernel",
      "format": "{sysname} {release}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;100;210;120}{#} {#38;2;100;210;120}kernel  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "wm",
      "format": "{pretty-name} ({protocol-name})",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}wm      {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "terminal",
      "format": "{pretty-name} {version}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}term    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;100;210;120}{#} {#38;2;100;210;120}shell   {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "command",
      "text": "pgrep -x llama-server >/dev/null && echo 'ON · 64k' || echo 'off'",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;190;110;230}󰚩{#} {#38;2;190;110;230}llm     {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "command",
      "shell": "/bin/bash",
      "text": "s=$(systemctl --user is-active hermes-gateway 2>/dev/null); echo ${s:-?}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}hermes  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "command",
      "text": "ip -4 -o addr show scope global | awk 'NR==1{sub(/\\/.*/,\"\",$4); print $4}'",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}ip      {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}├───────────┤{#}"
    },
    {
      "type": "cpu",
      "format": "{name} ({cores-logical}) {temperature}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}cpu     {#}{#38;2;110;200;190}│{#}",
      "temp": true
    },
    {
      "type": "command",
      "text": "nvidia-smi --query-gpu=name,temperature.gpu --format=csv,noheader,nounits | sed 's/NVIDIA GeForce //; s/, /  /; s/$/°C/'",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}{#} {#38;2;240;150;50}gpu     {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "command",
      "text": "nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits | awk -F', ' '{printf \"%.1f / %.0f GiB\", $1/1024, $2/1024}'",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;240;150;50}󰍛{#} {#38;2;240;150;50}vram    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}  {percentage}",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;90;210;200}{#} {#38;2;90;210;200}memory  {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "command",
      "text": "df -BG --output=used,size / /mnt/Datos | awk 'NR>1{gsub(/G/,\"\");printf \"%s%s/%sG\",(NR>2?\" · \":\"\"),$1,$2}'",
      "key": "{#38;2;110;200;190}│ {#}{#38;2;80;160;240}{#} {#38;2;80;160;240}disk    {#}{#38;2;110;200;190}│{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;200;190}╰───────────╯{#}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}